# Copy this file to .env on the VPS and fill in real values.
# Never commit the real .env file.

# Used by both the app container's DATABASE_URL and the db container itself
# (docker-compose reads POSTGRES_PASSWORD from this same file). Keep them in sync.
POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://stairwise:CHANGE_ME@db:5432/stairwise"

JWT_SECRET="generate a long random string, e.g. `openssl rand -hex 32`"

TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_VERIFY_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

PORT=3000
